# Copia este archivo a .env.local y completa los valores reales.
# Ver docs/operations/configuration.md para el detalle de cada variable.

# URL base del backend NestJS. Se expone al navegador (prefijo NEXT_PUBLIC_),
# así que nunca debe contener secretos.
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Si apunta a localhost y la página se abre por otra dirección (p. ej. la IP de
# la laptop desde el celular), el navegador usa esa dirección en lugar de localhost.
