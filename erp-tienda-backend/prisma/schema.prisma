/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuarios {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique @db.VarChar(100)
  rol           String    @db.VarChar(20)
  password_hash String    @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  // Los usuarios nunca se borran (la autoría del historial se conserva): se
  // desactivan. Un usuario inactivo no puede entrar y su token deja de servir.
  activo        Boolean   @default(true)

  // Trazabilidad de autor (Bloque 1, §5.2). Back-relations de usuario_id.
  cajas_turnos            cajas_turnos[]            @relation("TurnoAbiertoPor")
  turnos_cerrados         cajas_turnos[]            @relation("TurnoCerradoPor")
  ventas                  ventas[]                  @relation("VentaUsuario")
  ventas_anuladas         ventas[]                  @relation("VentaAnuladaPor")
  movimientos_financieros movimientos_financieros[]
  ajustes_inventario      ajustes_inventario[]
  devoluciones            devoluciones[]
  historial_precios       historial_precios_presentaciones[]
  compras_inventario      compras_inventario[]
  abonos_deuda            abono_deuda[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ventas {
  id                 Int              @id @default(autoincrement())
  caja_turno_id      Int
  total              Decimal          @db.Decimal(10, 2)
  fecha              DateTime?        @default(now()) @db.Timestamptz(6)
  estado             String           @default("COMPLETADA") @db.VarChar(20)
  justificacion_nula String?          @db.Text
  fecha_anulacion    DateTime?        @db.Timestamptz(6)
  usuario_id         Int?
  // Quién anuló la venta (D-06: la cajera anula, con su nombre registrado).
  anulada_por_id     Int?
  // Idempotencia de POST /ventas: header opcional Idempotency-Key. Un reintento
  // con la misma clave devuelve la venta ya creada en vez de duplicarla.
  clave_idempotencia String?          @unique @db.VarChar(64)
  detalle_ventas     detalle_ventas[]
  devoluciones       devoluciones[]
  cajas_turnos       cajas_turnos     @relation(fields: [caja_turno_id], references: [id], onUpdate: NoAction, map: "fk_caja_venta")
  usuarios           usuarios?        @relation("VentaUsuario", fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuario_venta")
  anulada_por        usuarios?        @relation("VentaAnuladaPor", fields: [anulada_por_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuario_anula_venta")

  // reportes.service.ts filtra siempre estado + fecha juntos (estado de
  // resultados, productos top, margen por producto).
  @@index([estado, fecha])
  @@index([caja_turno_id])
  @@index([usuario_id])
  @@index([anulada_por_id])
}

// La tabla caja_general se eliminó en el Bloque 1.C: el saldo de bóveda se
// DERIVA del libro de movimientos_financieros vía (cuenta_origen, cuenta_destino).
// Ver docs/historial/modelo-contable/00-especificaciones.md §5.1.

// Devolución de cliente post-turno (Bloque 3.B, ítem 13). Ligada a la venta
// original: revierte el costo FIFO al lote exacto y reembolsa desde el turno
// actual. La venta original permanece COMPLETADA (fue una venta real); la
// devolución vive en su propia tabla. Ver docs/historial/modelo-contable/bloque3-especificaciones.md §3.
model devoluciones {
  id                   Int                    @id @default(autoincrement())
  venta_id             Int
  caja_turno_id        Int
  usuario_id           Int?
  fecha                DateTime?              @default(now()) @db.Timestamptz(6)
  total_reembolsado    Decimal                @db.Decimal(10, 2)
  justificacion        String?
  ventas               ventas                 @relation(fields: [venta_id], references: [id], onUpdate: NoAction, map: "fk_venta_devolucion")
  cajas_turnos         cajas_turnos           @relation(fields: [caja_turno_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_caja_devolucion")
  usuarios             usuarios?              @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuario_devolucion")
  detalle_devoluciones detalle_devoluciones[]

  @@index([venta_id])
  @@index([caja_turno_id])
  @@index([usuario_id])
  @@index([fecha])
}

// Detalle de una devolución: cuánto se devolvió de cada línea de la venta, su
// destino (REINGRESO al lote / MERMA descartada), el monto reembolsado y el
// costo FIFO revertido (para el P&L: REINGRESO baja el costo de ventas; MERMA
// lo deja como pérdida).
model detalle_devoluciones {
  id                   Int            @id @default(autoincrement())
  devolucion_id        Int
  detalle_venta_id     Int
  cantidad             Decimal        @db.Decimal(12, 3)
  destino              String         @db.VarChar(20)
  subtotal_reembolsado Decimal        @db.Decimal(10, 2)
  costo_revertido      Decimal        @db.Decimal(10, 2)
  devoluciones         devoluciones   @relation(fields: [devolucion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_devolucion")
  detalle_ventas       detalle_ventas @relation(fields: [detalle_venta_id], references: [id], onUpdate: NoAction, map: "fk_detalle_venta_devolucion")

  @@index([devolucion_id])
  @@index([detalle_venta_id])
}

// Historial de precios de presentaciones (Bloque 3.C, ítem 16). Se registra una
// fila cada vez que cambia `precio_venta`, para poder responder "¿cuándo y de
// cuánto a cuánto cambié el precio?". El histórico de VENTAS ya sobrevive los
// cambios de precio (el subtotal se congela en detalle_ventas).
model historial_precios_presentaciones {
  id              Int            @id @default(autoincrement())
  presentacion_id Int
  precio_anterior Decimal        @db.Decimal(10, 2)
  precio_nuevo    Decimal        @db.Decimal(10, 2)
  fecha           DateTime?      @default(now()) @db.Timestamptz(6)
  usuario_id      Int?
  presentaciones  presentaciones @relation(fields: [presentacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_presentacion_historial")
  usuarios        usuarios?      @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuario_historial_precio")

  @@index([presentacion_id])
  @@index([usuario_id])
}

/// L5a (D-01): "deuda de stock". Lo que se vendió sin que el sistema tuviera
/// stock registrado. El costo de la venta queda congelado al estimado; cuando
/// entra stock real (compra o conteo sobrante) se cubre del lote sin tocar ese
/// costo. Ver docs/domain/caja-y-ventas.md.
model pendientes_stock {
  id                      Int               @id @default(autoincrement())
  detalle_venta_id        Int
  producto_id             Int
  // Lo que faltó al vender (unidades base). No cambia.
  cantidad_base           Decimal           @db.Decimal(12, 3)
  // Lo que aún no se ha cubierto con stock real.
  cantidad_pendiente      Decimal           @db.Decimal(12, 3)
  costo_unitario_estimado Decimal           @db.Decimal(10, 4)
  fecha                   DateTime          @default(now()) @db.Timestamptz(6)
  resuelto_en             DateTime?         @db.Timestamptz(6)
  // Último lote que cubrió parte (o todo) de este pendiente.
  lote_resuelto_id        Int?
  detalle_ventas          detalle_ventas    @relation(fields: [detalle_venta_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pendiente_detalle_venta")
  productos               productos         @relation(fields: [producto_id], references: [id], onUpdate: NoAction, map: "fk_pendiente_producto")
  lotes_inventario        lotes_inventario? @relation(fields: [lote_resuelto_id], references: [id], onUpdate: NoAction, map: "fk_pendiente_lote")

  @@index([producto_id, resuelto_en])
  @@index([detalle_venta_id])
}
