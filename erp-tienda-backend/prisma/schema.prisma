/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cuentas_por_pagar {
  id                 Int                 @id @default(autoincrement())
  compra_id          Int?
  acreedor           String              @db.VarChar(150)
  monto_deuda        Decimal             @db.Decimal(10, 2)
  saldo_pendiente    Decimal             @db.Decimal(10, 2)
  fecha_creacion     DateTime?           @default(now()) @db.Timestamptz(6)
  compras_inventario compras_inventario? @relation(fields: [compra_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_compra")
  abonos             abono_deuda[]

  @@index([compra_id])
}

/// Pagos parciales o totales de una deuda con un proveedor (L8, D-05).
model abono_deuda {
  id            Int                      @id @default(autoincrement())
  cuenta_id     Int
  monto         Decimal                  @db.Decimal(10, 2)
  fecha         DateTime                 @default(now()) @db.Timestamptz(6)
  usuario_id    Int?
  movimiento_id Int?
  nota          String?                  @db.VarChar(255)
  cuenta        cuentas_por_pagar        @relation(fields: [cuenta_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_abono_cuenta")
  usuarios      usuarios?                @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_abono_usuario")
  movimiento    movimientos_financieros? @relation(fields: [movimiento_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_abono_movimiento")

  @@index([cuenta_id])
  @@index([usuario_id])
  @@index([movimiento_id])
  @@map("abonos_cuentas_por_pagar")
}

