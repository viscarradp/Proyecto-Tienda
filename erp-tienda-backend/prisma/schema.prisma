  nombre           String             @db.VarChar(150)
  categoria_id     Int
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  // L5a (D-02): alta rápida de la cajera; la dueña lo revisa y lo apaga.
  por_revisar      Boolean            @default(false)
  lotes_inventario lotes_inventario[]
