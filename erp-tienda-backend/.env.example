# Copia este archivo a .env y completa los valores reales.
# Ver docs/operations/configuration.md para el detalle de cada variable.

# Cadena de conexión a PostgreSQL (Supabase u otro proveedor).
DATABASE_URL="postgresql://usuario:password@localhost:5432/erp_tienda"

# Secreto para firmar/verificar los JWT. Obligatorio: el servidor no arranca
# sin esta variable. Usa un valor largo y aleatorio (ej. openssl rand -hex 32).
JWT_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"

# Puerto donde escucha el backend (opcional, por defecto 3000).
PORT=3000

# Contraseña del usuario "admin" que se crea automáticamente la primera vez
# que el sistema arranca con la tabla de usuarios vacía. Si esta variable no
# está definida, NO se crea ningún admin (ver docs/decisions/0003).
INITIAL_ADMIN_PASSWORD="cambia-esta-contraseña"

# Orígenes permitidos por CORS, separados por coma. Por defecto solo el
# frontend de desarrollo local.
CORS_ORIGINS="http://localhost:3001"

# Entorno de ejecución. Swagger solo se enciende con "development" o con
# ENABLE_SWAGGER=true (si falta NODE_ENV queda apagado).
NODE_ENV=development

# Fuerza Swagger encendido aunque NODE_ENV=production (opcional).
# ENABLE_SWAGGER=true

# Zona horaria del negocio (nombre IANA). Los reportes agrupan por día según el
# reloj de la tienda, no el de UTC. Opcional, por defecto America/El_Salvador.
# Si el valor es inválido, el servidor no arranca.
# ZONA_HORARIA_NEGOCIO="America/El_Salvador"

# --- Despliegue (ver docs/operations/deployment.md) ---

# Con NODE_ENV=production el servidor NO arranca si falta CORS_ORIGINS o si
# JWT_SECRET tiene menos de 32 caracteres (o es un valor de ejemplo).

# Saltos de proxy en los que confiar para obtener la IP real del cliente (el
# rate-limit cuenta por IP). Vacío = desactivado. Render: 1. Nunca "true".
# TRUST_PROXY=1

# Máximo de conexiones del pool de PostgreSQL por instancia (default 5).
# instancias x DB_POOL_MAX debe caber en el límite de conexiones de la BD.
# DB_POOL_MAX=5

# --- Cierre de caja ---

# Monto en dólares desde el cual un descuadre al cerrar caja o en el arqueo de
# bóveda exige justificación. Opcional, por defecto 1.00.
# TOLERANCIA_DESCUADRE=1.00

# --- Bot de Telegram (opcional; ver docs/operations/configuration.md) ---

# Modo del bot: apagado (default), polling (demo local, sin URL pública) o
# webhook (producción).
# TELEGRAM_MODO=polling

# Token que entrega @BotFather. Es un secreto: nunca lo subas al repo.
# TELEGRAM_BOT_TOKEN=123456:token-de-ejemplo

# Quién puede usar el bot: telegramUserId:nombreDeUsuario del ERP (ADMIN activo),
# separados por coma.
# TELEGRAM_USUARIOS=123456789:admin

# Solo con webhook: URL pública del backend que Telegram llamará. Se registra
# sola al arrancar.
# TELEGRAM_WEBHOOK_URL=https://tu-backend.example.com/telegram/webhook

# Solo con webhook: texto aleatorio de 16 caracteres o más que Telegram envía
# en cada llamada (ej. openssl rand -hex 24).
# TELEGRAM_WEBHOOK_SECRET=reemplaza-con-un-texto-aleatorio-largo

# Clave de OpenRouter, que interpreta los mensajes. Es un secreto.
# OPENROUTER_API_KEY=sk-or-ejemplo

# ID exacto del modelo en OpenRouter. Se cambia sin tocar código.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Modelo para las fotos de factura; si falta, se usa OPENROUTER_MODEL (que
# entonces debe aceptar imágenes).
# OPENROUTER_MODEL_VISION=anthropic/claude-sonnet-5.5

# deny (default): solo proveedores que no guardan los datos; allow lo relaja.
# OPENROUTER_DATA_COLLECTION=deny
