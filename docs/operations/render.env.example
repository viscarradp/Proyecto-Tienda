# Plantilla de variables del backend para Render (sin secretos; sí está en GitHub).
# Cómo usarla: copia este archivo, completa CORS_ORIGINS y pégalo en Render → tu servicio
# del backend → Environment → "Add from .env" → Save. Render vuelve a desplegar solo.
# Los secretos (DATABASE_URL, JWT_SECRET) se cargan directo en Render, nunca aquí.

# Modo producción: exige CORS_ORIGINS y un JWT_SECRET de 32 caracteres o más; si falta
# alguno, el servidor NO arranca (a propósito, para no quedar abierto por error).
NODE_ENV=production

# La dirección de tu frontend en Vercel, con https y sin "/" al final. Si tienes más de
# una (p. ej. un dominio propio), sepáralas con coma.
CORS_ORIGINS=https://CAMBIA-ESTO.vercel.app

# Render pone un proxy delante del backend; sin esto el límite de intentos de login
# trataría a toda la tienda como un solo cliente.
TRUST_PROXY=1

# Los reportes cortan el día a medianoche de El Salvador (es el valor por defecto;
# queda explícito para que se vea).
ZONA_HORARIA_NEGOCIO=America/El_Salvador

# ── Ya las tienes en Render: NO las pegues de nuevo ──────────────────────────────
# DATABASE_URL  → la de Supabase. En Render usa la del pooler ("Session pooler",
#                 puerto 5432), porque la conexión directa de Supabase es solo IPv6.
# JWT_SECRET    → mínimo 32 caracteres.

# ── Solo si la base NO tiene ningún usuario ──────────────────────────────────────
# Con la base vacía, el backend crea el usuario "admin" con esta contraseña al
# arrancar. Si ya existe algún usuario, se ignora. Después del primer ingreso,
# cambia la contraseña y borra esta variable en Render.
# INITIAL_ADMIN_PASSWORD=

# ── Bot de Telegram (opcional; sin TELEGRAM_MODO queda apagado) ──────────────────
# En Render se usa "webhook": Telegram avisa al backend cuando la dueña escribe.
# Con "webhook", si faltan el token o el secreto el servidor NO arranca.
# TELEGRAM_MODO=webhook
# Tu backend en Render, terminado en /telegram/webhook. Se registra solo al arrancar.
# TELEGRAM_WEBHOOK_URL=https://CAMBIA-ESTO.onrender.com/telegram/webhook
# Quién puede usarlo: telegramUserId:nombreDeUsuario (ADMIN activo), separados por coma.
# TELEGRAM_USUARIOS=
# Modelo de IA que interpreta las compras (OpenRouter). Se cambia sin tocar código.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_DATA_COLLECTION=deny
# Secretos: cárgalos directo en Render, nunca aquí.
#   TELEGRAM_BOT_TOKEN       → el que entrega @BotFather.
#   TELEGRAM_WEBHOOK_SECRET  → 16 caracteres o más (openssl rand -hex 24).
#   OPENROUTER_API_KEY       → la clave de tu cuenta de OpenRouter.

# ── No definir ───────────────────────────────────────────────────────────────────
# PORT            → Render lo pone solo.
# ENABLE_SWAGGER  → apagado en producción (la documentación de la API no queda pública).
# DB_POOL_MAX     → 5 por defecto, suficiente para el plan gratis de Supabase.
